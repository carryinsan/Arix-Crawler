{
  "version": 2,
  "builds": [
    {
      "src": "api/crawler.rs",
      "use": "@vercel/rust"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.{js,css}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/crawler",
      "dest": "/api/crawler.rs"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
